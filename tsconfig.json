{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "outDir": "dist", "rootDir": ".", "sourceMap": true, "skipLibCheck": true
  },
  "include": ["compiler/**/*.ts", "tests/**/*.ts"]
}
